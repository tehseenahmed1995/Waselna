<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Property">
            <directory>tests/Property</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            The suite boots the application, so it must satisfy the boot-time
            configuration contract of App\Shared\Support\Configuration\
            RequiredConfiguration on its own, independently of any local
            environment file (Requirements 24.9, 44.8).
        -->
        <env name="APP_ENV" value="testing"/>
        <env name="APP_NAME" value="Waselna"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="/>
        <env name="APP_DEBUG" value="true"/>
        <env name="APP_URL" value="http://localhost"/>
        <env name="APP_LOCALE" value="en"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="LOG_CHANNEL" value="stack"/>
        <env name="LOG_LEVEL" value="debug"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="CACHE_PREFIX" value="waselna_testing"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_USERNAME" value="testing"/>
        <env name="DB_PASSWORD" value="testing"/>
        <env name="DB_URL" value=""/>
        <env name="REDIS_CLIENT" value="phpredis"/>
        <env name="REDIS_HOST" value="127.0.0.1"/>
        <env name="REDIS_PORT" value="6379"/>
        <env name="REDIS_PASSWORD" value="null"/>
        <env name="REVERB_APP_ID" value="waselna-testing"/>
        <env name="REVERB_APP_KEY" value="waselna-testing-key"/>
        <env name="REVERB_APP_SECRET" value="waselna-testing-secret"/>
        <env name="REVERB_HOST" value="127.0.0.1"/>
        <env name="REVERB_PORT" value="8080"/>
        <env name="REVERB_SCHEME" value="http"/>
        <env name="FILESYSTEM_DISK" value="local"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="MAIL_FROM_ADDRESS" value="no-reply@waselna.local"/>
        <env name="MAIL_FROM_NAME" value="Waselna"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="QUEUE_FAILED_DRIVER" value="database-uuids"/>
        <env name="WEB_CLIENT_ORIGINS" value="http://localhost:5173"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="THROTTLE_CACHE_STORE" value="array"/>
        <env name="LOG_STACK" value="structured"/>
        <env name="LOG_STRUCTURED_STREAM" value="php://memory"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
