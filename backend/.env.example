# Waselna — example environment file (Requirements 24.6, 44.2, 44.3).
#
# Every variable belongs to exactly one of the nine grouping headings APP,
# DATABASE, REDIS, CACHE, QUEUE, REVERB, FILESYSTEM, MAIL, API. Every value here
# is a non-secret local placeholder; no production credential belongs in this
# file. docs/architecture/local.md documents each variable's purpose, format,
# default, heading, and whether it holds a secret.
#
# Copy to .env before starting the Local_Dev_Environment (the backend container
# entrypoint does this automatically on a clean checkout). A variable that is
# absent or empty terminates startup with a message naming it and its heading.

# ============================ APP ============================
APP_NAME=Waselna
APP_ENV=local
# Local placeholder key. Replace with `php artisan key:generate` per checkout.
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# The `structured` channel emits the single-line JSON entries of Requirement
# 27.3. Leave LOG_STRUCTURED_STREAM empty to write storage/logs/delivery-api.log;
# set it to php://stderr in a container so the runtime collects the entries.
LOG_CHANNEL=stack
LOG_STACK=structured
LOG_STRUCTURED_STREAM=
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Published host ports of the Local_Dev_Environment.
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Demonstration seeder credentials (`php artisan db:seed`). Local placeholders
# only; the seeder stores the password as a salted adaptive hash.
SEED_ADMIN_EMAIL=admin@waselna.local
SEED_ADMIN_PASSWORD=local-seed-password

# ========================== DATABASE =========================
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=waselna
DB_USERNAME=waselna
DB_PASSWORD=waselna_local_password

# =========================== REDIS ===========================
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

# =========================== CACHE ===========================
CACHE_STORE=redis
CACHE_PREFIX=waselna_cache
THROTTLE_CACHE_STORE=redis

# =========================== QUEUE ===========================
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
REDIS_QUEUE=default

# ========================== REVERB ===========================
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=waselna-local
REVERB_APP_KEY=waselna-local-key
REVERB_APP_SECRET=waselna-local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# ======================== FILESYSTEM =========================
FILESYSTEM_DISK=local

# ============================ MAIL ===========================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@waselna.local"
MAIL_FROM_NAME="${APP_NAME}"

# ============================ API ============================
# Comma-separated Web_Client origins granted cross-origin access.
WEB_CLIENT_ORIGINS=http://localhost:5173
SECURITY_HSTS="max-age=31536000; includeSubDomains"
SECURITY_CSP="default-src 'none'; frame-ancestors 'none'; base-uri 'none'"

# Web_Client build-time values consumed by the Vite development server.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_REVERB_HOST=localhost
